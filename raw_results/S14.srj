n.de/drugbank/resource/drugs/DB00151"},"mass":{"type":"literal","value":"121.0197"},"transform":{"type":"literal","value":"'null'"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00151"},"mass":{"type":"literal","value":"121.0197"},"transform":{"type":"literal","value":"'null'"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00152"},"mass":{"type":"literal","value":"265.1123"},"transform":{"type":"literal","value":"Hepatic"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00152"},"mass":{"type":"literal","value":"300.0812"},"transform":{"type":"literal","value":"Hepatic"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00153"},"mass":{"type":"literal","value":"396.3392"},"transform":{"type":"literal","value":"Within the liver, ergocalciferol is hydroxylated to ercalcidiol (25-hydroxyergocalciferol) by the enzyme 25-hydroxylase. Within the kidney, ercalcidiol serves as a substrate for 1-alpha-hydroxylase, yielding ercalcitriol (1,25-dihydroxyergocalciferol), the biologically active form of vitamin D2."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00153"},"mass":{"type":"literal","value":"396.3392"},"transform":{"type":"literal","value":"Within the liver, ergocalciferol is hydroxylated to ercalcidiol (25-hydroxyergocalciferol) by the enzyme 25-hydroxylase. Within the kidney, ercalcidiol serves as a substrate for 1-alpha-hydroxylase, yielding ercalcitriol (1,25-dihydroxyergocalciferol), the biologically active form of vitamin D2."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00154"},"mass":{"type":"literal","value":"306.2559"},"transform":{"type":"literal","value":"'null'"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00241"},"mass":{"type":"literal","value":"224.1161"},"transform":{"type":"literal","value":"Hepatic, although most of the dose is eliminated via the kidney (59 to 88%). Urinary excretion products included parent drug (about 3.6% of the dose), 5-isobutyl-5-(2,3-dihydroxypropyl) barbituric acid (about 24% of the dose), 5-allyl-5(3-hydroxy-2-methyl-1-propyl) barbituric acid (about 4.8%)."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00242"},"mass":{"type":"literal","value":"285.0629"},"transform":{"type":"literal","value":"Metabolized in all cells with deoxycytidine kinase activity to 2-chloro-2'-deoxyadenosine-5'-triphosphate"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00206"},"mass":{"type":"literal","value":"608.2734"},"transform":{"type":"literal","value":"'null'"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00206"},"mass":{"type":"literal","value":"608.2734"},"transform":{"type":"literal","value":"'null'"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00208"},"mass":{"type":"literal","value":"263.0535"},"transform":{"type":"literal","value":"Metabolized extensively by the liver; only trace amounts of intact drug are detected in the urine. At least 20 metabolites have been identified. It has been proposed that 1 or more active metabolites may account for ticlopidine's activity, because ticlopidine itself is an extremely weak platelet aggregation inhibitor in vitro at the concentrations achieved in vivo. However, no active metabolite has been identified."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00208"},"mass":{"type":"literal","value":"263.0535"},"transform":{"type":"literal","value":"Metabolized extensively by the liver; only trace amounts of intact drug are detected in the urine. At least 20 metabolites have been identified. It has been proposed that 1 or more active metabolites may account for ticlopidine's activity, because ticlopidine itself is an extremely weak platelet aggregation inhibitor in vitro at the concentrations achieved in vivo. However, no active metabolite has been identified."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00374"},"mass":{"type":"literal","value":"390.2406"},"transform":{"type":"literal","value":"Substantially metabolized by the liver, but the precise enzymes responsible are unknown. Five metabolites have been described (HU1 through HU5) however, the biological activity and metabolic fate of these are unknown. The chemical structure of HU1 is unknown. The metabolite HU5 is the glucuronide conjugate of treprostinil. The other metabolites are formed by oxidation of the 3-hydroxyoctyl side chain (HU2) and subsequent additional oxidation (HU3) or dehydration (HU4). Study results of in vitro human hepatic cytochrome P450 demonstrates that treprostinil does not inhibit CYP-1A2, 2C9, 2C19, 2D6, 2E1, or 3A. Whether treprostinil induces these enzymes has not been studied."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00315"},"mass":{"type":"literal","value":"287.1634"},"transform":{"type":"literal","value":"Hepatic. There have been three metabolites identified: indole acetic acid, N -oxide, and N-desmethyl metabolites. However, the N-desmethyl is the only active metabolite."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00315"},"mass":{"type":"literal","value":"287.1634"},"transform":{"type":"literal","value":"Hepatic. There have been three metabolites identified: indole acetic acid, N -oxide, and N-desmethyl metabolites. However, the N-desmethyl is the only active metabolite."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00316"},"mass":{"type":"literal","value":"151.0633"},"transform":{"type":"literal","value":"Approximately 90 to 95% of a dose is metabolized in the liver via the cytochrome P450 enzyme pathways (primarily by conjugation with glucuronic acid, sulfuric acid, and cysteine). An intermediate metabolite is hepatotoxic and most likely nephrotoxic and can accumulate after the primary metabolic pathways have been saturated."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00316"},"mass":{"type":"literal","value":"151.0633"},"transform":{"type":"literal","value":"Approximately 90 to 95% of a dose is metabolized in the liver via the cytochrome P450 enzyme pathways (primarily by conjugation with glucuronic acid, sulfuric acid, and cysteine). An intermediate metabolite is hepatotoxic and most likely nephrotoxic and can accumulate after the primary metabolic pathways have been saturated."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00317"},"mass":{"type":"literal","value":"446.1521"},"transform":{"type":"literal","value":"Primarily hepatic via CYP3A4. Three sites of biotransformation have been identified: metabolism of the N-propoxymorpholino-group, demethylation of the methoxy-substituent on the quinazoline, and oxidative defluorination of the halogenated phenyl group."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00318"},"mass":{"type":"literal","value":"299.1521"},"transform":{"type":"literal","value":"Hepatic. Codeine is a prodrug, itself inactive, but demethylated to the active morphine by the liver enzyme CYP2D6."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00320"},"mass":{"type":"literal","value":"679.2676"},"transform":{"type":"literal","value":"Hepatic"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00258"},"mass":{"type":"literal","value":"157.9892"},"transform":{"type":"literal","value":"'null'"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00261"},"mass":{"type":"literal","value":"254.9966"},"transform":{"type":"literal","value":"Extensive, with \u003c 1% recovered unchanged in the urine. Metabolized primarily in the liver by cytochrome P450 1A2 (CYP1A2). Recently, it was found that anagrelide is bio-transformed in humans into two major metabolites (6,7-dichloro-3-hydroxy-1,5 dihydro-imidazo[2,1-b]quinazolin-2-one (BCH24426) and 2-amino-5,6-dichloro-3,4,-dihydroquinazoline (RL603). Whether these metabolites have biological activities that may underlie the mode of action of the parent drug is presently unclear."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00262"},"mass":{"type":"literal","value":"213.0072"},"transform":{"type":"literal","value":"Hepatic and rapid with active metabolites. Metabolites may persist in the plasma for several days."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00265"},"mass":{"type":"literal","value":"203.131"},"transform":{"type":"literal","value":"'null'"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00266"},"mass":{"type":"literal","value":"336.0634"},"transform":{"type":"literal","value":"'null'"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00266"},"mass":{"type":"literal","value":"336.0634"},"transform":{"type":"literal","value":"'null'"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00268"},"mass":{"type":"literal","value":"260.1889"},"transform":{"type":"literal","value":"Hepatic. Ropinirole is extensively metabolized to inactive metabolites via N -despropylation and hydroxylation pathways, largely by the P450 isoenzyme CYP1A2. N-despropyl ropinirole is the predominant metabolite found in urine (40%), followed by the carboxylic acid metabolite (10%), and the glucuronide of the hydroxy metabolite (10%)."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00268"},"mass":{"type":"literal","value":"260.1889"},"transform":{"type":"literal","value":"Hepatic. Ropinirole is extensively metabolized to inactive metabolites via N -despropylation and hydroxylation pathways, largely by the P450 isoenzyme CYP1A2. N-despropyl ropinirole is the predominant metabolite found in urine (40%), followed by the carboxylic acid metabolite (10%), and the glucuronide of the hydroxy metabolite (10%)."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00226"},"mass":{"type":"literal","value":"524.2628"},"transform":{"type":"literal","value":"Primarily hepatic"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00174"},"mass":{"type":"literal","value":"132.0535"},"transform":{"type":"literal","value":"'null'"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00175"},"mass":{"type":"literal","value":"424.2461"},"transform":{"type":"literal","value":"Hepatic, there is a small amount of metabolism by P450 enzymes, but this effect is so minimal that inhibitory pharmacokinetic drug interactions have no real effect on its overall activity and elimination. An in vitro study which found moderate affinity for P450 2C9 (major), 2D6 and 3A4."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00175"},"mass":{"type":"literal","value":"424.2461"},"transform":{"type":"literal","value":"Hepatic, there is a small amount of metabolism by P450 enzymes, but this effect is so minimal that inhibitory pharmacokinetic drug interactions have no real effect on its overall activity and elimination. An in vitro study which found moderate affinity for P450 2C9 (major), 2D6 and 3A4."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00176"},"mass":{"type":"literal","value":"318.1555"},"transform":{"type":"literal","value":"Hepatic"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00176"},"mass":{"type":"literal","value":"318.1555"},"transform":{"type":"literal","value":"Hepatic"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00177"},"mass":{"type":"literal","value":"435.227"},"transform":{"type":"literal","value":"'null'"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00178"},"mass":{"type":"literal","value":"416.2311"},"transform":{"type":"literal","value":"Hepatic. Ramipril is a prodrug and is converted to the active metabolite ramiprilat by liver esterase enzymes."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00179"},"mass":{"type":"literal","value":"302.1518"},"transform":{"type":"literal","value":"'null'"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00180"},"mass":{"type":"literal","value":"434.2105"},"transform":{"type":"literal","value":"Primarily hepatic, converted to the S beta-OH metabolite."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00181"},"mass":{"type":"literal","value":"213.0557"},"transform":{"type":"literal","value":"Hepatic"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00182"},"mass":{"type":"literal","value":"135.1048"},"transform":{"type":"literal","value":"Hepatic"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00182"},"mass":{"type":"literal","value":"135.1048"},"transform":{"type":"literal","value":"Hepatic"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00183"},"mass":{"type":"literal","value":"767.3312"},"transform":{"type":"literal","value":"Primarily hepatic"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resourc