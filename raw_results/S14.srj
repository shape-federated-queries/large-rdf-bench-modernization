ype":"literal","value":"418.174"},"transform":{"type":"literal","value":"Hepatic."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00394"},"mass":{"type":"literal","value":"408.1704"},"transform":{"type":"literal","value":"Metabolism mediated via esterase enzymes that are found in most tissues. Undergoes rapid and extensive conversion to beclomenthasone-17-monopropionate (17-BMP) during absorption"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00394"},"mass":{"type":"literal","value":"408.1704"},"transform":{"type":"literal","value":"Metabolism mediated via esterase enzymes that are found in most tissues. Undergoes rapid and extensive conversion to beclomenthasone-17-monopropionate (17-BMP) during absorption"}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00395"},"mass":{"type":"literal","value":"260.1736"},"transform":{"type":"literal","value":"Hepatic. Metabolized in the liver via the cytochrome P450 oxidase isozyme CYP2C19."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00395"},"mass":{"type":"literal","value":"260.1736"},"transform":{"type":"literal","value":"Hepatic. Metabolized in the liver via the cytochrome P450 oxidase isozyme CYP2C19."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00396"},"mass":{"type":"literal","value":"314.2246"},"transform":{"type":"literal","value":"Progesterone is metabolized primarily by the liver largely to pregnanediols and pregnanolones."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00396"},"mass":{"type":"literal","value":"314.2246"},"transform":{"type":"literal","value":"Progesterone is metabolized primarily by the liver largely to pregnanediols and pregnanolones."}},{"drug":{"type":"uri","value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00397"},"m